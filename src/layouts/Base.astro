---
interface Props { title: string; description: string; lang?: string }
const { title, description, lang = 'pt-BR' } = Astro.props;
import '@/styles/global.css';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0d16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Before the first paint: if the intro is going to play, hide the site and show the
         loader now, instead of flashing the site and yanking the visitor back into the intro
         once the 3D has loaded. A safety net brings the site back if the intro never mounts. -->
    <script is:inline>
      try {
        // ?intro plays it again for whoever skipped it before (from the start, lamp still off)
        if (new URLSearchParams(location.search).has('intro')) {
          localStorage.removeItem('intro-skipped');
          sessionStorage.removeItem('intro-seen');
        }
        if (!localStorage.getItem('intro-skipped') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.intro = 'on';
          // the intro always starts at the top: a reload must not restore a scroll position deep in it
          history.scrollRestoration = 'manual';
          window.scrollTo(0, 0);
          setTimeout(function () {
            if (!window.__intro) delete document.documentElement.dataset.intro;
          }, 10000);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-deep text-bone">
    <div id="intro-loader" aria-hidden="true"><span>arosisca@fedora</span><i></i></div>
    <slot />
  </body>
</html>
