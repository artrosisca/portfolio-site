---
interface Props { title: string; description: string; lang?: string }
const { title, description, lang = 'pt-BR' } = Astro.props;
import '@/styles/global.css';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- palette under evaluation: ?palette=<name>, remembered locally; set before first paint -->
    <script is:inline>
      (() => {
        const q = new URLSearchParams(location.search).get('palette');
        if (q) localStorage.setItem('palette', q);
        const p = q || localStorage.getItem('palette');
        if (p && p !== 'ambar') document.documentElement.dataset.palette = p;
      })();
    </script>
  </head>
  <body class="bg-ink text-cream">
    <slot />
  </body>
</html>
