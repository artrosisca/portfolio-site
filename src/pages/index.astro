---
import Base from '@/layouts/Base.astro';
import Intro from '@/components/intro/Intro';
import SiteHero from '@/components/site/SiteHero';
import SoundToggle from '@/components/site/SoundToggle';
import Contact from '@/components/site/Contact.astro';
---
<Base
  title="Arthur Rosisca — Full-Stack & Dados"
  description="Portfólio de Arthur Rosisca: desenvolvedor full-stack e engenharia de dados."
>
  <Intro client:only="react" />
  <SoundToggle client:only="react" />

  <main>
    <SiteHero />
    <!-- Placeholder for the rest of the site. We'll design this next. -->
    <section id="projetos" class="mx-auto max-w-5xl px-6 py-32 md:px-12">
      <p class="font-mono text-sm text-accent">$ ls projetos/</p>
      <p class="mt-4 text-bone/60">Em construção.</p>
      <div class="h-[40vh]"></div>
    </section>
    <Contact />
  </main>
</Base>
